{
  "name": "typespec-extension-exporter",
  "version": "0.4.0",
  "description": "TypeSpec emitter that exports @extension metadata as raw occurrences, Java beta inputs, or grouped beta name lists, serialized as JSON, YAML, or CSV.",
  "type": "module",
  "license": "MIT",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "tspMain": "dist/src/index.js",
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "sample"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "watch": "tsc -p . --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist",
    "foundry:emit": "node foundry/emit.mjs",
    "foundry:emit:agents": "node foundry/emit.mjs agents",
    "foundry:emit:projects": "node foundry/emit.mjs projects"
  },
  "peerDependencies": {
    "@azure-tools/typespec-client-generator-core": ">=0.68.0",
    "@typespec/compiler": ">=1.12.0",
    "@typespec/openapi": ">=1.12.0"
  },
  "devDependencies": {
    "@azure-tools/openai-typespec": "1.20.1",
    "@azure-tools/typespec-azure-core": "0.69.0",
    "@azure-tools/typespec-client-generator-core": "0.69.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.21",
    "@typespec/compiler": "1.13.0",
    "@typespec/events": "0.83.0",
    "@typespec/http": "1.13.0",
    "@typespec/openapi": "1.13.0",
    "@typespec/openapi3": "1.13.0",
    "@typespec/rest": "0.83.0",
    "@typespec/sse": "0.83.0",
    "@typespec/streams": "0.83.0",
    "@typespec/versioning": "0.83.0",
    "@typespec/xml": "0.83.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@typespec/asset-emitter": "0.79.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalvarezl/typespec-extension-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/jpalvarezl/typespec-extension-exporter/issues"
  },
  "homepage": "https://github.com/jpalvarezl/typespec-extension-exporter#readme"
}
