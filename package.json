{
  "name": "typespec-extension-exporter",
  "version": "0.2.0",
  "description": "TypeSpec emitter that exports @extension metadata as raw occurrences, revapi ignores, or AST annotation input, serialized as JSON, YAML, or CSV.",
  "type": "module",
  "license": "MIT",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "tspMain": "dist/src/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "sample",
    "foundry/*.tspconfig.yaml",
    "foundry/setup-foundry-deps.sh"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "watch": "tsc -p . --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "foundry:setup": "bash foundry/setup-foundry-deps.sh",
    "foundry:emit:agents": "tsp compile \"$FOUNDRY_DIR/src/sdk-java-azure-ai-agents/client.tsp\" --config foundry/agents.tspconfig.yaml",
    "foundry:emit:projects": "tsp compile \"$FOUNDRY_DIR/src/sdk-java-azure-ai-projects/client.tsp\" --config foundry/projects.tspconfig.yaml",
    "foundry:emit": "npm run foundry:emit:agents && npm run foundry:emit:projects"
  },
  "peerDependencies": {
    "@azure-tools/typespec-client-generator-core": ">=0.69.0",
    "@typespec/compiler": ">=1.13.0",
    "@typespec/openapi": ">=1.13.0"
  },
  "devDependencies": {
    "@azure-tools/openai-typespec": "1.20.1",
    "@azure-tools/typespec-azure-core": "0.69.0",
    "@azure-tools/typespec-client-generator-core": "0.69.0",
    "@types/node": "^22.19.21",
    "@typespec/compiler": "1.13.0",
    "@typespec/events": "0.83.0",
    "@typespec/http": "1.13.0",
    "@typespec/openapi": "1.13.0",
    "@typespec/openapi3": "1.13.0",
    "@typespec/rest": "0.83.0",
    "@typespec/sse": "0.83.0",
    "@typespec/streams": "0.83.0",
    "@typespec/versioning": "0.83.0",
    "@typespec/xml": "0.83.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@typespec/asset-emitter": "0.79.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalvarezl/typespec-extension-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/jpalvarezl/typespec-extension-exporter/issues"
  },
  "homepage": "https://github.com/jpalvarezl/typespec-extension-exporter#readme"
}
